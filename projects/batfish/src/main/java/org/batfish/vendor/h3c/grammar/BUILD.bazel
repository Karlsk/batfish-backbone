load("@rules_java//java:defs.bzl", "java_library")
load("@batfish//skylark:pmd_test.bzl", "pmd_test")

package(default_visibility = ["//visibility:public"])

java_library(
    name = "h3c_base",
    srcs = ["H3cBaseLexer.java"],
    deps = ["//projects/common:parser_common", "@maven//:org_antlr_antlr4_runtime"],
)

java_library(
    name = "grammar",
    srcs = glob(["*.java"], exclude = ["H3cBaseLexer.java"]),
    deps = [
        "//projects/batfish/src/main/antlr4/org/batfish/vendor/h3c/grammar",
        "//projects/batfish/src/main/java/org/batfish/vendor/h3c/representation",
        "//projects/common",
        "@maven//:com_google_guava_guava",
        "@maven//:org_antlr_antlr4_runtime",
    ],
)

pmd_test(
    name = "pmd",
    lib = ":grammar",
)
